#include <iostream>
#include <cassert>
#include <initializer_list>

using namespace std;

class IntArray
{
private:
	int m_length = 0;
	int* m_data = nullptr;

public:
	//Constructors
	IntArray(const initializer_list<int> & list)
	{
		m_data = new int[list.size()];
		m_length = list.size();
		initialize(list);
	}

	//Destructors
	~IntArray()
	{
		delete[] this->m_data;
	}

	//initialize()
	void initialize(const initializer_list<int> & list)
	{
		int count = 0;
		for (auto& ele : list) {
			m_data[count] = ele;
			++ count;
		}
	}

	//copy()
	void copy(const int* src, const int & src_size, int* & dst, const int & dst_size)
	{

		if (dst != nullptr) {
			delete[] dst;
			dst = nullptr;
		}

		dst = new int[dst_size];
		for (int i = 0; i < dst_size; ++i) {
			if (i < src_size) {
				dst[i] = src[i];
			}
			else {
				dst[i] = 0;
			}
		}

	}

	//reset()
	void reset()
	{
		delete[] this->m_data;
		m_data = nullptr;
		m_length = 0;
	}

	//resize()
	void resize(const int size)
	{
		if (size <= 0) {
			reset();
			return;
		}

		int* copy_data = nullptr;
		int copy_length = 0;

		copy(m_data, m_length, copy_data, m_length);
		copy_length = m_length;

		reset();

		m_length = size;
		copy(copy_data, copy_length, m_data, m_length);

		delete[] copy_data;

	}

	//insertBefore()
	void insertBefore(const int& value, const int& idx)
	{
		if (idx < 0 || idx >= m_length) {
			cerr << "Invalid index for insertBefore" << endl;
			return;
		}

		int* copy_data = nullptr;
		int copy_length = 0;

		copy(m_data, m_length, copy_data, m_length);
		copy_length = m_length;

		resize(idx);

		push_back(value);

		for (int i = idx; i < copy_length; i++) {
			push_back(copy_data[i]);
		}

		delete[] copy_data;
	}
	 
	//remove() //idx : 0부터 시작
	void remove(const int & idx)
	{
		if (idx < 0 || idx >= m_length) {
			cerr << "Invalid index for remove" << endl;
			return;
		}

		int* copy_data = nullptr;
		int copy_length = 0;

		copy(m_data, m_length, copy_data, m_length);
		copy_length = m_length;

		resize(idx);

		for (int i = idx + 1; i < copy_length; i++) {
			push_back(copy_data[i]);
		}

		delete[] copy_data;
		
	}
	 
	//push_back(const int & value);
	void push_back(const int& value)
	{
		//cout << "m_length : " << m_length << endl;

		resize(m_length+1);

		m_data[m_length-1] = value;
	}
	 
	 
	//operator <<
	friend ostream& operator << (ostream& out, IntArray& arr)
	{

		for (int i = 0; i < arr.m_length; ++i) {
			out << arr.m_data[i] << " ";
		}
		return out;
	}
	
};

int main()
{
	IntArray my_arr{ 1, 3, 5, 7, 9 };
	cout << my_arr << endl;
	
	my_arr.resize(6);				//1, 3, 5, 7, 9, 0
	cout << my_arr << endl;

	my_arr.resize(4);				//1, 3, 5, 7
	cout << my_arr << endl;

	my_arr.push_back(13);			//1, 3, 5, 7, 13
	cout << my_arr << endl;

	my_arr.remove(2);				//1, 3, 7, 13		//index 3번째 요소 삭제
	cout << my_arr << endl;

	my_arr.insertBefore(10, 1);		//1, 10, 3, 7, 13
	cout << my_arr << endl;


	return 0;
}
