#include <iostream>
using namespace std;

class Cents
{
private:
  int m_cents;

public:
  Cents(int cents) 
  {
    m_cents = cents;
  }

  int getCents() const 
  {
    return m_cents;
  }

  Cents operator + (const Cents &c2)
  {
    return Cents(this->m_cents + c2.m_cents);
  }

}

int main()
{
  Cents cents1(1);
  Cents cents2(2);

  cout << (cents1 + cents2 + Cents(3)).getCents() << endl; // 1+2+3 = 6

  return 0;
}
