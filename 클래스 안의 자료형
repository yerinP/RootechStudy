#include <iostream>

class Fruit
{
  enum FruitType
  {
    APPLE, 
    BANANA, 
    CHERRY,
  }

  private:
    FruitType m_type;
  
  public:
    Fruit(FruitType type) : m_type(type)
    {}

    FruitType getType() 
    { 
      return m_type; 
    }
}

int main()
{
  Fruit apple(Fruit::APPLE);

  if (apple.getType == Fruit::APPLE)
  {
    std::cout << "APPLE" << std::endl;
  }

  return 0;
}
